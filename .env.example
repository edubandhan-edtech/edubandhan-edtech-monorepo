# EduBandhan Production Environment Configuration Template
PORT=8000
APP_ENV=staging

# Database Connections (Neon PostgreSQL with pgvector)
DATABASE_URL=postgresql://neondb_owner:***@ep-***-pooler.c-7.us-east-2.aws.neon.tech/neondb?sslmode=require
DIRECT_URL=postgresql://neondb_owner:***@ep-***.c-7.us-east-2.aws.neon.tech/neondb?sslmode=require

# Authentication Secrets
JWT_SECRET=your_super_secret_jwt_key_here
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=43200

# Platform Settings
PLATFORM_FEE_PERCENTAGE=20
FACE_SIMILARITY_THRESHOLD=0.85
CUTOFF_TIME=08:30:00

# Groq Cloud AI LLM
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=qwen/qwen3.8-27b
